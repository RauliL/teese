    "@varasto/fs-storage": "^4.0.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "morgan": "^1.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl": "^10.1.26",
